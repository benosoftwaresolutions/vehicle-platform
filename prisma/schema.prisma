generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  clerkId              String    @unique
  email                String    @unique
  name                 String?
  role                 String    @default("pending")
  garageId             String?
  onboardingStep       Int       @default(0)
  profileComplete      Boolean   @default(false)
  plan                 String    @default("driver_free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  subscriptionEnd      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  vehicles             Vehicle[]
}

model Vehicle {
  id                 String    @id @default(cuid())
  clerkId            String
  make               String
  model              String
  year               String
  registration       String
  colour             String?
  fuelType           String?   // petrol | diesel | electric | hybrid | phev
  motExpiry          DateTime?
  lastServiceDate    DateTime?
  nextServiceDue     DateTime?
  currentMileage     Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [clerkId], references: [clerkId])
}

model Garage {
  id                   String    @id @default(cuid())
  name                 String
  address              String
  city                 String
  postcode             String
  description          String?
  email                String?
  phone                String?
  rating               Float     @default(0)
  services             String[]
  servicePricing       Json?
  specialistMakes      String[]
  logoUrl              String?
  approved             Boolean   @default(false)
  adminNotes           String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String    @default("trialing")
  trialEndsAt          DateTime?
  subscriptionEnd      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  clerkId         String?
  garageId        String
  service         String
  date            DateTime
  time            String
  registration    String
  status          String    @default("pending")
  isWalkIn        Boolean   @default(false)
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  vehicleMake     String?
  vehicleModel    String?
  garageNote      String?
  suggestedDate   DateTime?
  suggestedTime   String?
  jobValue        Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GarageAvailability {
  id           String   @id @default(cuid())
  garageId     String   @unique
  slotDuration Int
  capacity     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  schedule     DaySchedule[]
}

model DaySchedule {
  id             String             @id @default(cuid())
  availabilityId String
  day            String
  isOpen         Boolean            @default(true)
  startTime      String
  endTime        String
  availability   GarageAvailability @relation(fields: [availabilityId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  garageId     String
  clerkId      String
  customerName String
  rating       Int
  comment      String
  createdAt    DateTime @default(now())

  @@unique([garageId, clerkId])
}

model Part {
  id            String   @id @default(cuid())
  garageId      String
  name          String
  category      String?
  quantity      Float    @default(0)
  reorderLevel  Float    @default(0)
  unit          String   @default("units")
  supplier      String?
  supplierEmail String?
  costPrice     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceType {
  id          String   @id @default(cuid())
  garageId    String
  name        String
  duration    Int
  price       Float?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerNote {
  id           String   @id @default(cuid())
  garageId     String
  registration String
  note         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([garageId, registration])
}