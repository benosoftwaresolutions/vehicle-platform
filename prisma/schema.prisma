generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  name      String?
  role      String    @default("customer")
  garageId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
}

model Vehicle {
  id           String   @id @default(cuid())
  clerkId      String
  make         String
  model        String
  year         String
  registration String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [clerkId], references: [clerkId])
}

model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  postcode  String
  rating    Float    @default(0)
  services  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id           String   @id @default(cuid())
  clerkId      String
  garageId     String
  service      String
  date         DateTime
  time         String
  registration String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GarageAvailability {
  id           String   @id @default(cuid())
  garageId     String   @unique
  workingDays  String[]
  startTime    String
  endTime      String
  slotDuration Int
  capacity     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}