generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  clerkId         String    @unique
  email           String    @unique
  name            String?
  role            String    @default("pending")
  garageId        String?
  onboardingStep  Int       @default(0)
  profileComplete Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  vehicles        Vehicle[]
}

model Vehicle {
  id           String   @id @default(cuid())
  clerkId      String
  make         String
  model        String
  year         String
  registration String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [clerkId], references: [clerkId])
}

model Garage {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  postcode    String
  description String?
  rating      Float    @default(0)
  services         String[]
  specialistMakes  String[]
  logoUrl          String?
  createdAt        DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  clerkId         String?
  garageId        String
  service         String
  date            DateTime
  time            String
  registration    String
  status          String    @default("pending")
  isWalkIn        Boolean   @default(false)
  customerName    String?
  customerPhone   String?
  garageNote      String?
  suggestedDate   DateTime?
  suggestedTime   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GarageAvailability {
  id           String   @id @default(cuid())
  garageId     String   @unique
  slotDuration Int
  capacity     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  schedule     DaySchedule[]
}

model DaySchedule {
  id             String             @id @default(cuid())
  availabilityId String
  day            String
  isOpen         Boolean            @default(true)
  startTime      String
  endTime        String
  availability   GarageAvailability @relation(fields: [availabilityId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  garageId     String
  clerkId      String
  customerName String
  rating       Int
  comment      String
  createdAt    DateTime @default(now())

  @@unique([garageId, clerkId])
}

model ServiceType {
  id          String   @id @default(cuid())
  garageId    String
  name        String
  duration    Int
  price       Float?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}